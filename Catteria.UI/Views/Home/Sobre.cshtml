@{
    ViewData["Title"] = "Sobre";
}

<div class="creators-page">
    <section class="hero-creators">
        <div class="container text-center">
            <span class="hero-badge">
                Catteria • Cafeteria Temática
            </span>

            <h1 class="hero-title">
                Sobre a <span>Catteria</span>
            </h1>

            <p class="hero-text mx-auto mt-4">
                Um espaço acolhedor para quem ama café, boa comida e a companhia dos gatos.
            </p>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <div class="about-box">
                <div class="row align-items-center g-5">
                    <div class="col-lg-5">
                        <div class="about-icon">
                            ✦
                        </div>

                        <h2 class="section-title mb-3">
                            Nossa história
                        </h2>

                        <p class="section-subtitle mb-0">
                            Uma cafeteria temática pensada para oferecer uma experiência acolhedora e especial.
                        </p>
                    </div>

                    <div class="col-lg-7">
                        <p class="text-muted" style="line-height: 1.8;">
                            A Catteria nasceu com a ideia de criar uma cafeteria temática diferente, onde o
                            carinho pelos gatos se encontra com a experiência de tomar um café especial. O
                            projeto começou de forma simples, com o objetivo de oferecer um ambiente leve,
                            criativo e aconchegante para receber amigos, famílias e visitantes da região.
                        </p>

                        <p class="text-muted mb-0" style="line-height: 1.8;">
                            Com o tempo, o espaço foi ganhando identidade própria, unindo decoração charmosa,
                            atendimento acolhedor e um cardápio pensado para momentos de pausa, conversa e
                            relaxamento. Esta história é apenas um ponto de partida e pode ser atualizada depois
                            com mais detalhes sobre a cafeteria.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title">
                    Horário de funcionamento
                </h2>

                <p class="section-subtitle">
                    Confira nossos horários de atendimento.
                </p>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="about-box">
                        <div class="row align-items-center g-4">
                            <div class="col-md-5 text-center">
                                <div class="about-icon mx-auto">
                                    ☕
                                </div>

                                <h4 class="member-name mb-2">
                                    Atendimento
                                </h4>

                                <p class="member-description mb-0">
                                    Um ambiente perfeito para apreciar café e passar um momento agradável.
                                </p>
                            </div>

                            <div class="col-md-7">
                                <ul class="list-unstyled mb-0" style="line-height: 1.9;">
                                    <li><strong>Segunda a sexta:</strong> 08:00 às 19:00</li>
                                    <li><strong>Sábado:</strong> 09:00 às 20:00</li>
                                    <li><strong>Domingo:</strong> 09:00 às 18:00</li>
                                    <li><strong>Feriados:</strong> consulte nossas redes sociais</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title">
                    Onde estamos
                </h2>

                <p class="section-subtitle">
                    Visite a Catteria e encontre um ambiente perfeito para apreciar café e passar um momento agradável.
                </p>
            </div>

            <div class="about-box">
                <div class="ratio ratio-16x9 rounded overflow-hidden">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3657.3721247827143!2d-46.63842482391453!3d-23.555074961362827!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94ce59a91dcdb5c5%3A0x346ddb9dcc8fbf61!2s89%C2%BAC%20Coffee%20Station!5e0!3m2!1spt-BR!2sbr!4v1789155178641!5m2!1spt-BR!2sbr"
                            width="600"
                            height="450"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="strict-origin-when-cross-origin"></iframe>
                </div>
            </div>
        </div>
    </section>
</div>