
@model Catteria.Application.DTOs.ForgotPasswordDto

@{
    ViewData["Title"] = "Esqueci minha senha";
}

<div class="container d-flex justify-content-center align-items-center"
     style="min-height: 75vh;">

    <div class="card border-0 shadow-lg"
         style="width: 100%; max-width: 460px; border-radius: 20px;">

        <div class="card-body p-4 p-md-5">

            <!-- Ícone -->
            <div class="text-center mb-4">
                <div class="d-inline-flex justify-content-center align-items-center
                    rounded-circle bg-light text-primary"
                     style="width: 75px; height: 75px;">
                    <i class="bi bi-key-fill" style="font-size: 34px;"></i>
                </div>
            </div>

            <!-- Título -->
            <div class="text-center mb-4">
                <h2 class="fw-bold mb-2">
                    Esqueceu sua senha?
                </h2>

                <p class="text-muted mb-0">
                    Não se preocupe! Informe seu e-mail e enviaremos
                    um link para você criar uma nova senha.
                </p>
            </div>

            <form asp-action="ForgotPassword" method="post">

                <!-- E-mail -->
                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-semibold">
                    </label>

                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"
                              style="border-radius: 12px 0 0 12px;">
                            <i class="bi bi-envelope"></i>
                        </span>

                        <input asp-for="Email"
                               class="form-control bg-light border-start-0"
                               placeholder="Digite seu e-mail"
                               style="border-radius: 0 12px 12px 0; height: 48px;" />
                    </div>

                    <span asp-validation-for="Email"
                          class="text-danger small">
                    </span>
                </div>

                <!-- Botão -->
                <button type="submit"
                        class="btn btn-primary w-100 fw-semibold"
                        style="border-radius: 12px; height: 48px;">
                    <i class="bi bi-send me-2"></i>
                    Enviar link de redefinição
                </button>

                @Html.AntiForgeryToken()

            </form>

            <!-- Voltar -->
            <div class="text-center mt-4">
                <a asp-controller="Account"
                   asp-action="Login"
                   class="text-decoration-none fw-semibold link-primary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Voltar para o login
                </a>
            </div>

        </div>
    </div>
</div>
