
@model Catteria.Application.DTOs.ResetPasswordDto

@{
    ViewData["Title"] = "Redefinir senha";
}

<div class="container d-flex justify-content-center align-items-center"
     style="min-height: 75vh;">

    <div class="card border-0 shadow-lg"
         style="width: 100%; max-width: 460px; border-radius: 20px;">

        <div class="card-body p-4 p-md-5">

            <!-- Ícone -->
            <div class="text-center mb-4">
                <div class="d-inline-flex justify-content-center align-items-center
                    rounded-circle bg-light text-primary"
                     style="width: 75px; height: 75px;">
                    <i class="bi bi-shield-lock-fill"
                       style="font-size: 34px;"></i>
                </div>
            </div>

            <!-- Título -->
            <div class="text-center mb-4">
                <h2 class="fw-bold mb-2">
                    Redefinir senha
                </h2>

                <p class="text-muted mb-0">
                    Crie uma nova senha segura para acessar
                    sua conta novamente.
                </p>
            </div>

            <form asp-action="ResetPassword" method="post">

                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Token" />

                <!-- Nova senha -->
                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold">
                    </label>

                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"
                              style="border-radius: 12px 0 0 12px;">
                            <i class="bi bi-lock"></i>
                        </span>

                        <input asp-for="Password"
                               type="password"
                               class="form-control bg-light border-start-0"
                               placeholder="Digite sua nova senha"
                               style="border-radius: 0 12px 12px 0; height: 48px;" />
                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger small">
                    </span>
                </div>

                <!-- Confirmar senha -->
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold">
                    </label>

                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"
                              style="border-radius: 12px 0 0 12px;">
                            <i class="bi bi-lock-fill"></i>
                        </span>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control bg-light border-start-0"
                               placeholder="Confirme sua nova senha"
                               style="border-radius: 0 12px 12px 0; height: 48px;" />
                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger small">
                    </span>
                </div>

                <!-- Dica -->
                <div class="alert alert-light border-0 mb-4"
                     style="border-radius: 12px;">
                    <div class="d-flex gap-2">
                        <i class="bi bi-info-circle-fill text-primary"></i>

                        <small>
                            Escolha uma senha que você ainda não
                            tenha usado em outros sites.
                        </small>
                    </div>
                </div>

                <!-- Botão -->
                <button type="submit"
                        class="btn btn-primary w-100 fw-semibold"
                        style="border-radius: 12px; height: 48px;">
                    <i class="bi bi-check2-circle me-2"></i>
                    Redefinir senha
                </button>

                @Html.AntiForgeryToken()

            </form>

            <!-- Voltar -->
            <div class="text-center mt-4">
                <a asp-controller="Account"
                   asp-action="Login"
                   class="text-decoration-none fw-semibold link-primary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Voltar para o login
                </a>
            </div>

        </div>
    </div>
</div>

