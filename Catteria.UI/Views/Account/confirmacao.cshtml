@{
    bool sucesso = ViewBag.Sucesso ?? false;
    string mensagem = ViewBag.Mensagem ?? string.Empty;

    ViewData["Title"] = sucesso
        ? "E-mail confirmado"
        : "Erro na confirmação";
}

<div class="container d-flex justify-content-center align-items-center"
     style="min-height: 75vh;">

    <div class="card border-0 shadow-lg text-center p-4 p-md-5"
         style="width: 100%; max-width: 500px; border-radius: 20px;">

        <div class="mb-4">
            @if (sucesso)
            {
                <div class="status-icon success-icon">
                    <i class="bi bi-check-lg"></i>
                </div>
            }
            else
            {
                <div class="status-icon error-icon">
                    <i class="bi bi-x-lg"></i>
                </div>
            }
        </div>

        <h2 class="fw-bold mb-3">
            @if (sucesso)
            {
                <text>E-mail confirmado!</text>
            }
            else
            {
                <text>Falha na confirmação</text>
            }
        </h2>

        <p class="text-muted mb-4">
            @if (!string.IsNullOrWhiteSpace(mensagem))
            {
                @mensagem
            }
            else if (sucesso)
            {
                <text>Seu e-mail foi confirmado com sucesso!</text>
            }
            else
            {
                <text>Não foi possível confirmar seu e-mail. O link pode ter expirado ou ser inválido.</text>
            }
        </p>

        @if (sucesso)
        {
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-dark w-100 py-2">
                <i class="bi bi-house-door me-2"></i>
                Ir para a página inicial
            </a>
        }
        else
        {
            <a asp-controller="Account"
               asp-action="ReenviarConfirmacao"
               class="btn btn-dark w-100 py-2 mb-2">
                <i class="bi bi-envelope me-2"></i>
                Reenviar confirmação
            </a>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary w-100 py-2">
                Voltar para a página inicial
            </a>
        }

        <div class="mt-4">
            <span class="text-muted small">
                Catteria
            </span>
        </div>
    </div>
</div>

<style>
    .status-icon {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
    }

    .success-icon {
        background-color: #d1e7dd;
        color: #198754;
    }

    .error-icon {
        background-color: #f8d7da;
        color: #dc3545;
    }
</style>