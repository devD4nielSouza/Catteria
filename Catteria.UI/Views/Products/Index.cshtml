@model ProductListViewModel

@{
    ViewData["Title"] = "Cardápio";
}

<div class="cat-menu-hero py-5 mb-5">
    <div class="container text-center">
        <h1 class="display-5 fw-bold">Nosso Cardápio</h1>
        <p class="lead mb-0">
            Cafés, doces, salgados e muito carinho em cada pedido.
        </p>
    </div>
</div>

<div class="container">

    <form asp-action="Index" method="get" class="mb-5">

        <div class="row justify-content-center">

            <div class="col-lg-5 col-md-7">

                <select class="form-select cat-filter"
                        name="SelectedCategoryById"
                        onchange="this.form.submit()">

                    <option value="">Todas as categorias</option>

                    @foreach (var category in Model.Categories)
                    {
                        if (Model.SelectedCategoryById == category.Id)
                        {
                            <option value="@category.Id" selected>
                                @category.Name
                            </option>
                        }
                        else
                        {
                            <option value="@category.Id">
                                @category.Name
                            </option>
                        }
                    }

                </select>

            </div>

        </div>

    </form>

    <div class="row g-4">

        @if (Model.PaginatedProducts.Any())
        {
            @foreach (var product in Model.PaginatedProducts)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">

                    <div class="card cat-card shadow-sm h-100">

                        <div class="cat-image">

                            @if (!string.IsNullOrEmpty(product.CoverImageUrl))
                            {
                                <img src="@product.CoverImageUrl"
                                     alt="@product.Name">
                            }
                            else
                            {
                                <div class="cat-no-image">
                                    Sem imagem
                                </div>
                            }

                        </div>

                        <div class="card-body d-flex flex-column">

                            <h5 class="fw-bold">
                                @product.Name
                            </h5>

                            @if (!string.IsNullOrWhiteSpace(product.Description))
                            {
                                <p class="text-muted cat-description">
                                    @product.Description
                                </p>
                            }

                            <div class="mt-auto">

                                <div class="d-flex justify-content-between align-items-center">

                                    <span class="cat-price">
                                        R$ @product.Price.ToString("N2")
                                    </span>

                                    <a asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="btn btn-primary rounded-pill">

                                        Ver detalhes

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="col-12">

                <div class="alert alert-warning text-center">

                    Nenhum produto encontrado.

                </div>

            </div>
        }

    </div>

    <!-- Paginação -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-5">
            <ul class="pagination justify-content-center">
                <!-- Botão Anterior -->
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" 
                       asp-action="Index"
                       asp-route-selectedcategorybyid="@Model.SelectedCategoryById"
                       asp-route-search="@Context.Request.Query["search"]"
                       asp-route-page="@(Model.CurrentPage - 1)">
                        Anterior
                    </a>
                </li>

                <!-- Números de Página -->
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" 
                           asp-action="Index"
                           asp-route-selectedcategorybyid="@Model.SelectedCategoryById"
                           asp-route-search="@Context.Request.Query["search"]"
                           asp-route-page="@i">
                            @i
                        </a>
                    </li>
                }

                <!-- Botão Próximo -->
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" 
                       asp-action="Index"
                       asp-route-selectedcategorybyid="@Model.SelectedCategoryById"
                       asp-route-search="@Context.Request.Query["search"]"
                       asp-route-page="@(Model.CurrentPage + 1)">
                        Próximo
                    </a>
                </li>
            </ul>
        </nav>
    }

    <br />
    <br />
    <br />
</div>