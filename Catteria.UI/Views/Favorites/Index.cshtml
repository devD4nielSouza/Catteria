@section Scripts {

    <script>
async function loadFavorites() {

    try {

        const response = await fetch(
            "http://localhost:5273/api/Favorites",
            {
                method: "GET",
                credentials: "include"
            }
        );

        if (!response.ok) {
            throw new Error(`Erro HTTP: ${response.status}`);
        }

        const products = await response.json();

        console.log("Favoritos:", products);

        document.getElementById("loading").style.display = "none";

        if (!products || products.length === 0) {

            document.getElementById("emptyFavorites").style.display = "block";

            return;
        }

        const container =
            document.getElementById("favoritesContainer");

        container.style.display = "flex";
        container.innerHTML = "";

        products.forEach(product => {

            const id = product.id;
            const name = product.name ?? "Produto";
            const description = product.description ?? "";
            const price = product.price ?? 0;
            const image = product.coverImageUrl;

            const imageHtml = image
                ? `
                    <img src="${image}"
                         class="card-img-top"
                         alt="${name}"
                         style="height: 220px; object-fit: cover;">
                  `
                : `
                    <div class="d-flex align-items-center justify-content-center"
                         style="height: 220px; background: #f5f5f5;">

                        <i class="bi bi-image fs-1 text-muted"></i>

                    </div>
                  `;

            container.innerHTML += `
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm border-0">

                        ${imageHtml}

                        <div class="card-body d-flex flex-column">

                            <h4 class="fw-bold">
                                ${name}
                            </h4>

                            <p class="text-muted">
                                ${description}
                            </p>

                            <h5 class="fw-bold mt-auto">
                                R$ ${Number(price).toLocaleString("pt-BR", {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                })}
                            </h5>

                            <div class="d-flex gap-2 mt-3">

                                <a href="/Products/Details/${id}"
                                   class="btn btn-success rounded-pill flex-grow-1">

                                    Ver produto

                                </a>

                                <button type="button"
                                        class="btn btn-outline-danger rounded-pill"
                                        onclick="removeFavorite(${id})"
                                        title="Remover dos favoritos">

                                    <i class="bi bi-heart-fill"></i>

                                </button>

                            </div>

                        </div>

                    </div>

                </div>
            `;
        });

    } catch (error) {

        console.error("Erro ao carregar favoritos:", error);

        document.getElementById("loading").innerHTML = `
            <div class="alert alert-danger">
                Não foi possível carregar seus favoritos.
            </div>
        `;
    }
}
    </script>
} *@
@{
    ViewData["Title"] = "Meus Favoritos";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="fw-bold">
            <i class="bi bi-heart-fill text-danger me-2"></i>
            Meus Favoritos
        </h1>

        <p class="text-muted">
            Produtos que você adicionou aos favoritos.
        </p>

    </div>

    <div id="loading" class="text-center">
        <div class="spinner-border"></div>

        <p class="mt-3">
            Carregando favoritos...
        </p>
    </div>

    <div id="error"
         class="alert alert-danger"
         style="display:none;">
    </div>

    <div id="empty"
         class="text-center"
         style="display:none;">

        <i class="bi bi-heart fs-1 text-muted"></i>

        <h3 class="mt-3">
            Você ainda não possui favoritos.
        </h3>

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-success rounded-pill mt-3">

            Ver cardápio

        </a>

    </div>

    <div id="favorites"
         class="row g-4"
         style="display:none;">
    </div>

</div>


@section Scripts {
    <script src="~/js/favorites.js"></script>
}