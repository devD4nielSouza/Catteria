@{
    ViewData["Title"] = "Pagamento";
}

<div class="container py-5">
    <div class="row g-4">

        <!-- Formulário de pagamento -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h2 class="mb-4">Pagamento</h2>

                    <form id="paymentForm">

                        <h5 class="mb-3">Forma de pagamento</h5>

                        <div class="mb-3">

                            <div class="form-check mb-2">
                                <input class="form-check-input"
                                       type="radio"
                                       name="formaPagamento"
                                       id="pix"
                                       value="pix"
                                       checked>

                                <label class="form-check-label" for="pix">
                                    PIX
                                </label>
                            </div>

                            <div class="form-check mb-2">
                                <input class="form-check-input"
                                       type="radio"
                                       name="formaPagamento"
                                       id="cartao"
                                       value="cartao">

                                <label class="form-check-label" for="cartao">
                                    Cartão de crédito/débito
                                </label>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input"
                                       type="radio"
                                       name="formaPagamento"
                                       id="retirada"
                                       value="retirada">

                                <label class="form-check-label" for="retirada">
                                    Pagar na retirada
                                </label>
                            </div>

                        </div>


                        <!-- PIX -->
                        <div id="pagamentoPix" class="payment-option">

                            <div class="alert alert-light border">

                                <h6>Pagamento via PIX</h6>

                                <p class="small text-muted">
                                    Esta é uma simulação de pagamento.
                                </p>

                                <div class="text-center">

                                    <div class="border p-4 d-inline-block mb-3">
                                        QR CODE
                                    </div>

                                    <p class="small">
                                        Código PIX fictício:
                                    </p>

                                    <input type="text"
                                           class="form-control"
                                           value="pix-demo-123456789"
                                           readonly>

                                </div>

                            </div>

                        </div>


                        <!-- CARTÃO -->
                        <div id="pagamentoCartao"
                             class="payment-option"
                             style="display: none;">

                            <div class="mb-3">

                                <label for="numeroCartao" class="form-label">
                                    Número do cartão
                                </label>

                                <input type="text"
                                       id="numeroCartao"
                                       class="form-control"
                                       placeholder="0000 0000 0000 0000"
                                       maxlength="19">

                            </div>

                            <div class="row">

                                <div class="col-md-6 mb-3">

                                    <label for="validade" class="form-label">
                                        Validade
                                    </label>

                                    <input type="text"
                                           id="validade"
                                           class="form-control"
                                           placeholder="MM/AA"
                                           maxlength="5">

                                </div>

                                <div class="col-md-6 mb-3">

                                    <label for="cvv" class="form-label">
                                        CVV
                                    </label>

                                    <input type="text"
                                           id="cvv"
                                           class="form-control"
                                           placeholder="000"
                                           maxlength="3">

                                </div>

                            </div>

                            <div class="mb-3">

                                <label for="parcelas" class="form-label">
                                    Parcelas
                                </label>

                                <select id="parcelas" class="form-select">

                                    <option value="1">1x sem juros</option>
                                    <option value="2">2x sem juros</option>
                                    <option value="3">3x sem juros</option>
                                    <option value="6">6x sem juros</option>
                                    <option value="12">12x sem juros</option>

                                </select>

                            </div>

                        </div>


                        <!-- RETIRADA -->
                        <div id="pagamentoRetirada"
                             class="payment-option"
                             style="display: none;">

                            <div class="alert alert-info">

                                <h6>Pagar na retirada</h6>

                                <p class="mb-0">
                                    Você realizará o pagamento quando retirar seu pedido.
                                </p>

                            </div>

                        </div>

                        <button type="button"
                                class="btn btn-dark w-100 mt-3"
                                onclick="finalizarPedido()">
                            Finalizar pagamento
                        </button>

                    </form>

                    <div id="mensagemPagamento"
                         class="mt-3 text-center">
                    </div>

                </div>
            </div>
        </div>


        <!-- Resumo do pedido -->
        <div class="col-lg-5">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h4 class="mb-4">Resumo do pedido</h4>

                    <div id="listaProdutos">
                        <!-- Produtos inseridos pelo JavaScript -->
                    </div>

                    <div class="mt-4">
                        <h5 class="mb-3">Observações do pedido</h5>

                        <textarea id="observacoesPedido"
                                  class="form-control"
                                  rows="4"
                                  maxlength="500"
                                  placeholder="Ex: Retirar no período da tarde..."></textarea>

                        <div class="form-text">
                            Opcional. Máximo de 500 caracteres.
                        </div>
                    </div>

                    <hr>

                    <div class="d-flex justify-content-between">
                        <span>Subtotal</span>
                        <strong id="subtotal">R$ 0,00</strong>
                    </div>

                    <div class="d-flex justify-content-between mt-2">
                        <span>Frete</span>
                        <strong id="frete">R$ 10,00</strong>
                    </div>

                    <hr>

                    <div class="d-flex justify-content-between fs-5">
                        <strong>Total</strong>
                        <strong id="total">R$ 0,00</strong>
                    </div>

                </div>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/pagamento.js"></script>
}