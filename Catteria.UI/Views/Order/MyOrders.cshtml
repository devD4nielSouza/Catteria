@model IEnumerable<Catteria.Application.DTOs.OrderDto>

@{
ViewData["Title"] = "Meus pedidos";
}

<div class="container py-5">


<div class="text-center mb-5">

    <div class="orders-header-icon mb-3">
        <i class="bi bi-receipt"></i>
    </div>

    <h1 class="fw-bold">
        Meus pedidos
    </h1>

    <p class="text-muted">
        Consulte seus pedidos e acompanhe o andamento.
    </p>

</div>


@if (Model != null && Model.Any())
{
    <div class="orders-list">

        @foreach (var order in Model)
        {
            var statusClass = order.StatusId switch
            {
                6 => "order-status-success",
                7 => "order-status-cancelled",
                _ => "order-status-progress"
            };

            var statusIcon = order.StatusId switch
            {
                6 => "bi-check-circle-fill",
                7 => "bi-x-circle-fill",
                5 => "bi-bicycle",
                4 => "bi-bag-check-fill",
                3 => "bi-cup-hot-fill",
                2 => "bi-check-circle-fill",
                _ => "bi-clock-fill"
            };

            <div class="order-card">

                <div class="order-main">

                    <div class="order-icon">

                        <i class="bi bi-receipt"></i>

                    </div>

                    <div>

                        <h5 class="fw-bold mb-1">
                            Pedido #@order.Id
                        </h5>

                        <span class="text-muted small">
                            @order.Date.ToString("dd/MM/yyyy HH:mm")
                        </span>

                    </div>

                </div>


                <div class="order-status-area">

                    <span class="order-status @statusClass">

                        <i class="bi @statusIcon me-1"></i>

                        @order.Status

                    </span>

                </div>


                <div class="order-total">

                    <small class="text-muted d-block">
                        Total
                    </small>

                    <strong>
                        @order.TotalValue.ToString("C")
                    </strong>

                </div>


                <div>

                    <a asp-controller="Order"
                       asp-action="Tracking"
                       asp-route-id="@order.Id"
                       class="btn btn-primary">

                        <i class="bi bi-truck me-1"></i>

                        Acompanhar

                    </a>

                </div>

            </div>
        }

    </div>
}
else
{
    <div class="empty-orders">

        <i class="bi bi-receipt"></i>

        <h4 class="fw-bold mt-3">
            Nenhum pedido encontrado
        </h4>

        <p class="text-muted">
            Você ainda não realizou nenhum pedido.
        </p>

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-primary">

            Ver cardápio

        </a>

    </div>
}


</div>
